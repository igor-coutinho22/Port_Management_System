@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

SHOW_PERSON_OUTLINE()

title System Context Diagram for Vessel Aggregate

Person(admin, "Admin", "Administers the system and manages vessels.")
Person(shipCaptain, "Ship Captain", "Operates the vessel.")

System(portSystem, "Port Management System", "Manages port operations, including vessels.")

Rel(admin, portSystem, "Manages Vessels", "HTTPS")
Rel(shipCaptain, portSystem, "Provides Vessel Info", "HTTPS")

@enduml
