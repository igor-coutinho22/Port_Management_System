@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

SHOW_PERSON_OUTLINE()

title Container Diagram for Qualification Aggregate

Person(operator, "Logistics Operator", "Manages qualifications.")

System_Boundary(c1, "Port Management System") {
    Container(webApp, "Web Application", "React, TypeScript", "Provides the UI for qualification management.")
    Container(api, "API Application", "ASP.NET Core", "Handles qualification management logic and data.")
    ContainerDb(database, "Database", "SQL Server", "Stores qualification data.")
}

Rel(operator, webApp, "Uses", "HTTPS")
Rel(webApp, api, "Makes API calls to", "JSON/HTTPS")
Rel(api, database, "Reads from and writes to", "Entity Framework/SQL")

@enduml
