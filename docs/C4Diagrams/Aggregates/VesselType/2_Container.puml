@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

SHOW_PERSON_OUTLINE()

title Container Diagram for VesselType Aggregate

Person(officer, "Port Authority Officer", "Manages vessel types.")

System_Boundary(c1, "Port Management System") {
    Container(webApp, "Web Application", "React, TypeScript", "Provides the UI for vessel type management.")
    Container(api, "API Application", "ASP.NET Core", "Handles vessel type management logic and data.")
    ContainerDb(database, "Database", "SQL Server", "Stores vessel type data.")
}

Rel(officer, webApp, "Uses", "HTTPS")
Rel(webApp, api, "Makes API calls to", "JSON/HTTPS")
Rel(api, database, "Reads from and writes to", "Entity Framework/SQL")

@enduml
