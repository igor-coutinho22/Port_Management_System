@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

SHOW_PERSON_OUTLINE()

title Container Diagram for Users Aggregate

Person(user, "User", "A user of the system.")

System_Boundary(c1, "Port Management System") {
    Container(webApp, "Web Application", "React, TypeScript", "Provides the UI for user management.")
    Container(api, "API Application", "ASP.NET Core", "Handles user management logic and authentication.")
    ContainerDb(database, "Database", "SQL Server", "Stores user data.")
}

Rel(user, webApp, "Uses", "HTTPS")
Rel(webApp, api, "Makes API calls to", "JSON/HTTPS")
Rel(api, database, "Reads from and writes to", "Entity Framework/SQL")

@enduml
