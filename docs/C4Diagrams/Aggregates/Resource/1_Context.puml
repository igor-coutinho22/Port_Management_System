@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

SHOW_PERSON_OUTLINE()

title System Context Diagram for Resource Aggregate

Person(admin, "Admin", "Administers the system and manages resources.")
Person(opsManager, "Operations Manager", "Manages port resources and operations.")

System(portSystem, "Port Management System", "Manages port operations, including resources.")

Rel(admin, portSystem, "Manages Resources", "HTTPS")
Rel(opsManager, portSystem, "Allocates Resources", "HTTPS")

@enduml
