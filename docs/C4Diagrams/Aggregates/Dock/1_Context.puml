@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

SHOW_PERSON_OUTLINE()

title System Context Diagram for Dock Aggregate

Person(admin, "Admin", "Administers the system and manages docks.")
Person(officer, "Port Authority Officer", "Manages port infrastructure including docks.")

