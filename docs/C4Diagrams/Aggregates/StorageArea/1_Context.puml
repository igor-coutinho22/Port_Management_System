@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

SHOW_PERSON_OUTLINE()

title System Context Diagram for StorageArea Aggregate

Person(admin, "Admin", "Administers the system and manages storage areas.")
Person(opsManager, "Operations Manager", "Manages port storage and capacity.")

System(portSystem, "Port Management System", "Manages port operations, including storage areas.")

Rel(admin, portSystem, "Manages Storage Areas", "HTTPS")
Rel(opsManager, portSystem, "Monitors Capacity", "HTTPS")

@enduml
