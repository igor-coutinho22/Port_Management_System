StaffController --> IStaffService
QualificationsController --> IQualificationsService
ResourcesController --> IResourcesService
StorageAreasController --> IStorageAreasService
DocksController --> IDocksService
VesselsController --> IVesselsService
VesselTypesController --> IVesselTypesService
VesselVisitNotificationsController --> IVesselVisitNotificationsService
RepresentativesController --> IRepresentativesService
UsersController --> IUsersService
OperationPlansController --> OperationPlanService
VesselVisitExecutionsController --> VesselVisitExecutionService
IncidentsController --> IncidentService
ComplementaryTasksController --> ComplementaryTaskService

IStaffService --> IStaffRepository
IQualificationsService --> IQualificationsRepository
