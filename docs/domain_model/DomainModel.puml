@startuml DomainModel
title Shipping Port Management System - Complete Domain Model (Master Data + OEM)

' === DOMAIN LAYER ===
package "Domain Layer" {

  ' ==========================================
  ' EXISTING MASTER DATA AGGREGATES (.NET)
  ' ==========================================

  ' ---- STAFF AGGREGATE ----
  package "Staff Aggregate" <<Aggregate>> {
    class Staff <<AggregateRoot>> {
      +MecanographicNumber : string <<PK>>
      +ShortName : string
      +Email : string
      +Phone : string
      +Status : StaffStatus
      +OperationalWindow : string
      +QualificationLinks : ICollection<QualificationLink>
      --
      +Activate() : void
      +Deactivate() : void
    }

    enum StaffStatus {
      Available
      Unavailable
    }

    class QualificationLink <<Entity>> {
      +StaffMecanographicNumber : string <<FK>>
      +QualificationCode : string <<FK>>
    }
  }

  ' ---- QUALIFICATION AGGREGATE ----
  package "Qualification Aggregate" <<Aggregate>> {
    class Qualification <<AggregateRoot>> {
      +Code : string <<PK>>
      +Name : string
      +QualificationLinks : ICollection<QualificationLink>
    }
  }

  ' ---- RESOURCE AGGREGATE ----
  package "Resource Aggregate" <<Aggregate>> {
    class Resource <<AggregateRoot>> {
      +Id : string <<PK>>
      +Description : string
      +ResourceType : ResourceType
      +OperationalCapacity : int
      +Status : ResourceAvailabilityStatus
      +SetupTime : int
      +QualificationCodes : List<string> <<FK to Qualification>>
    }

    enum ResourceType {
      STSCrane
      YardCrane
      Truck
      Tractor
    }

    enum ResourceAvailabilityStatus {
      Active
      Maintenance
      Inactive
    }
  }

  ' ---- STORAGE AREA AGGREGATE ----
  package "StorageArea Aggregate" <<Aggregate>> {
    abstract class StorageArea <<AggregateRoot>> {
      +Id : int <<PK>>
      +Name : string
      +Type : StorageAreaType
      +MaxCapacityTeu : int
      +CurrentOccupancyTeu : int
      +DockConnections : ICollection<DockStorageAreaInfo>
      --
      +CanAddTeus(teusToAdd: int) : bool
      +ChangeMaxCapacity(newMaxCapacityTeu: int) : void
      +UpdateCurrentOccupancy(newOccupancyTeu: int) : void
      +GetInfoForDock(dockId: Guid) : DockStorageAreaInfo
      +SetInfoForDock(dockId: Guid, info: DockStorageAreaInfo) : void
      +RemoveInfoForDock(dockId: Guid) : bool
      {abstract} +GetUsageDescription() : string
    }

    class ContainerYard {
      +DockIds : List<Guid> <<FK to Dock>>
      --
      +GetUsageDescription() : string
    }

    class Warehouse {
      +SpecializedCargoType : string
      --
      +UpdateCargoType(newType: string) : void
      +GetUsageDescription() : string
    }

    enum StorageAreaType {
      ContainerYard
      Warehouse
    }

    class DockStorageAreaInfo <<Entity>> {
      +Id : int <<PK>>
      +DockId : Guid <<FK>>
      +StorageAreaId : int <<FK>>
      +DistanceMeters : double
      +TravelSeconds : int
    }
  }

  ' ---- DOCK AGGREGATE ----
  package "Dock Aggregate" <<Aggregate>> {
    class Dock <<AggregateRoot>> {
      +Id : Guid <<PK>>
      +Name : string
      +Location : string
      +LengthMeters : double
      +DepthMeters : double
      +MaxDraftMeters : double
      +AllowedVesselTypeNames : List<string> <<FK to VesselType>>
      --
      +Update(name: string, location: string, length: double, depth: double, maxDraft: double, allowedVesselTypes: List<VesselType>) : void
      +AllowVesselType(vesselType: VesselType) : void
      +DisallowVesselType(vesselType: VesselType) : void
    }
  }

  ' ---- VESSEL AGGREGATE ----
  package "Vessel Aggregate" <<Aggregate>> {
    class Vessel <<AggregateRoot>> {
      +IMO : string <<PK>>
      +VesselName : string
      +OperatorName : string
      +VesselTypeName : string <<FK>>
      +RequiredCraneCount : int
      +RequiredDockLength : double
      +Bays : int
      +Rows : int
      +Tiers : int
      +CargoGrid : VesselGrid <<NotMapped>>
      --
      +IsValidIMO(imo: string) : bool <<static>>
    }

    class VesselGrid <<ValueObject>> {
      +Containers : Container[,,]
      +Bays : int
      +Rows : int
      +Tiers : int
      --
      +CanPlaceContainer(bay: int, row: int, tier: int) : bool
      +PlaceContainer(container: Container, bay: int, row: int, tier: int) : void
      +RemoveContainer(bay: int, row: int, tier: int) : Container
    }

    class Container <<ValueObject>> {
      +Id : Guid
      +Type : string
      +Weight : double
    }
  }

  ' ---- VESSEL TYPE AGGREGATE ----
  package "Vessel Type Aggregate" <<Aggregate>> {
    class VesselType <<AggregateRoot>> {
      +Name : string <<PK>>
      +Description : string
      +MaxBays : int
      +MaxRows : int
      +MaxTiers : int
      +MaxTEUCapacity : int <<computed>>
      --
      +CreateForUpdate(name: string, description: string, maxBays: int, maxRows: int, maxTiers: int) : VesselType <<static>>
    }
   }

  ' ---- VESSEL VISIT NOTIFICATION AGGREGATE ----
  package "Vessel Visit Notification Aggregate" <<Aggregate>> {
    class VesselVisitNotification <<AggregateRoot>> {
      +Id : Guid <<PK>>
      +VesselIMO : string <<FK>>
      +VisitDate : DateTime
      +DockId : Guid <<FK>>
      +Status : VesselVisitStatus
      +Purpose : VisitPurpose
      +LoadingManifest : CargoManifest
      +UnloadingManifest : CargoManifest
      +Crew : List<CrewMember>
      +DecisionLogs : List<DecisionLog>
      --
      +AddLoadingManifest(manifest: CargoManifest) : void
      +AddUnloadingManifest(manifest: CargoManifest) : void
      +AddCrewMember(name: string, citizenId: string, nationality: string) : void
      +MarkAsSubmitted() : void
      +Approve(officerId: Guid, dockId: Guid) : void
      +Reject(officerId: Guid, reason: string) : void
      +UpdateVesselIMO(newIMO: string) : void
      +UpdatePurpose(newPurpose: VisitPurpose) : void
      +UpdateDockId(newDockId: Guid) : void
      +UpdateVisitDate(newDate: DateTime) : void
      +UpdateLoadingManifest(manifest: CargoManifest) : void
      +UpdateUnloadingManifest(manifest: CargoManifest) : void
      +UpdateCrew(crew: IEnumerable<CrewMember>) : void
    }

    enum VesselVisitStatus {
      InProgress
      Submitted
      Approved
      Rejected
    }

    enum VisitPurpose {
      Commercial
      Maintenance
    }

    class CargoManifest <<Entity>> {
      +Id : Guid <<PK>>
      +Type : CargoManifestType
      +LoadingManifestForId : Guid <<FK>>
      +UnloadingManifestForId : Guid <<FK>>
    }

    enum CargoManifestType {
      Loading
      Unloading
    }

    class DecisionLog <<Entity>> {
      +Id : Guid <<PK>>
      +OfficerId : Guid
      +Outcome : DecisionOutcome
      +Details : string
      +Timestamp : DateTime
    }

    enum DecisionOutcome {
      Approved
      Rejected
    }
  }

  ' ---- REPRESENTATIVE AGGREGATE ----
  package "Representative Aggregate" <<Aggregate>> {
    class Representative <<AggregateRoot>> {
      +Id : Guid <<PK>>
      +OrganizationId : Guid <<FK>>
      +Name : string
      +CitizenId : string
      +Nationality : string
      +Email : string
      +Phone : string
      +IsActive : bool
      --
      +Update(name: string, citizenId: string, nationality: string, email: string, phone: string) : void
      +UpdateProfile(name: string, citizenId: string, nationality: string, email: string, phone: string) : void
      +SetActive(isActive: bool) : void
    }

    class ShippingAgentOrganization <<Entity>> {
          +Id : Guid <<PK>>
          +LegalName : string
          +AlternativeNames : string
          +Address : string
          +TaxNumber : string
          --
          +Update(legalName: string, alternativeNames: string, address: string, taxNumber: string) : void
          +UpdateProfile(legalName: string, alternativeNames: string, address: string, taxNumber: string) : void
        }
  }

  ' ---- USERS AGGREGATE ----
  package "Users Aggregate" <<Aggregate>> {
    class ApplicationUser <<AggregateRoot>> {
      +Id : string <<PK>>
      +UserName : string
      +Email : string
      +EmailConfirmed : bool
      +FullName : string
    }
  }

  ' ---- CREW AGGREGATE ----
  package "Crew Aggregate" <<Aggregate>> {
    class CrewMember <<Entity>> {
      +Id : Guid <<PK>>
      +Name : string
      +CitizenId : string
      +Nationality : string
      +VesselVisitNotificationId : Guid <<FK>>
    }
  }

  ' ==========================================
  ' NEW OEM AGGREGATES (NODE.JS)
  ' ==========================================

  package "Operation Plan Aggregate" <<Aggregate>> {
    class OperationPlan <<AggregateRoot>> {
      +Id : Guid <<PK>>
      +ScheduleDate : Date
      +HeuristicUsed : string
      +Status : OperationPlanStatus
      +Items : List<OperationPlanItem>
      +AuditLog : List<Log>
      --
      +Approve() : void
      +UpdateItem(item: PlanItemUpdate) : void
    }

    class OperationPlanItem <<Entity>> {
      +VesselVisitId : Guid <<FK>>
      +OperationType : string
      +StartTime : Date
      +EndTime : Date
      +NumberOfCranes : int
      +NumberOfStaff : int
    }

    enum OperationPlanStatus {
      Draft
      Approved
      Executed
    }
  }

  package "Vessel Visit Execution Aggregate" <<Aggregate>> {
    class VesselVisitExecution <<AggregateRoot>> {
      +Id : Guid <<PK>>
      +VesselVisitId : Guid <<FK>>
      +ActualArrivalTime : Date
      +ActualBerthTime : Date
      +ActualUnberthTime : Date
      +ActualPortDepartureTime : Date
      +Status : VVEStatus
      +ExecutedOperations : List<ExecutedOperation>
      +DockId : Guid <<FK>>
      --
      +Complete() : void
      +UpdateBerthTime(time: Date, dockId: Guid) : void
    }

    class ExecutedOperation <<Entity>> {
      +OperationId : Guid
      +ActualStartTime : Date
      +ActualEndTime : Date
      +Status : string
    }

    enum VVEStatus {
      InProgress
      Completed
    }
  }

  package "Incident Aggregate" <<Aggregate>> {
    class Incident <<AggregateRoot>> {
      +Id : Guid <<PK>>
      +IncidentTypeId : Guid <<FK>>
      +Description : string
      +StartTime : Date
      +EndTime : Date
      +Severity : SeverityLevel
      +Status : IncidentStatus
      +AffectedVVEs : List<Guid> <<FK>>
      --
      +Resolve(endTime: Date) : void
    }

    class IncidentType <<Entity>> {
      +Id : Guid <<PK>>
      +Code : string
      +Name : string
      +ParentTypeId : Guid <<FK>>
    }

    enum IncidentStatus {
      Active
      Resolved
    }
  }

  package "Complementary Task Aggregate" <<Aggregate>> {
    class ComplementaryTask <<AggregateRoot>> {
      +Id : Guid <<PK>>
      +CategoryId : Guid <<FK>>
      +VesselVisitExecutionId : Guid <<FK>>
      +ResponsibleTeam : string
      +StartTime : Date
      +EndTime : Date
      +Status : TaskStatus
    }

    class ComplementaryTaskCategory <<Entity>> {
      +Id : Guid <<PK>>
      +Code : string
      +Name : string
      +ExpectedImpact : TaskImpact
    }

    enum TaskImpact {
      Parallel
      Suspension
    }
  }
}

' === DOMAIN RELATIONSHIPS ===
' Existing
ContainerYard --> StorageArea : is a
Warehouse --> StorageArea : is a
StorageArea --> "1..*" DockStorageAreaInfo : contains
Staff --> "0..*" QualificationLink : has
Qualification --> "0..*" QualificationLink : linked to
Vessel --> "1" VesselGrid : has
VesselGrid --> "0..*" Container : contains
VesselVisitNotification --> "0..2" CargoManifest : manifest
VesselVisitNotification --> "1..*" CrewMember : has crew
VesselVisitNotification --> "1..*" DecisionLog : has decisions
Staff --> "1" StaffStatus : uses
Resource --> "1" ResourceType : uses
Resource --> "1" ResourceAvailabilityStatus : uses
StorageArea --> "1" StorageAreaType : uses
VesselVisitNotification --> "1" VesselVisitStatus : uses
VesselVisitNotification --> "1" VisitPurpose : uses
CargoManifest --> "1" CargoManifestType : uses
DecisionLog --> "1" DecisionOutcome : uses
Representative "1..*" --> "1" ShippingAgentOrganization : is part of
Representative "1" --> "0..*" VesselVisitNotification : requests
CrewMember "1" --> "1" ApplicationUser : is
Vessel "0..*" --> "1" VesselType : VesselTypeName
VesselVisitNotification "0..*" --> "1" Vessel : vesselIMO
VesselVisitNotification "0..*" --> "1" Dock : dockId
StorageArea "0..*" --> "0..*" Dock : dockIds (ContainerYard)
Resource "0..*" --> "1..*" Qualification : qualificationCodes

' NEW OEM RELATIONSHIPS
OperationPlan --> "1..*" OperationPlanItem : contains
OperationPlan --> "1" OperationPlanStatus : uses
VesselVisitExecution --> "1..*" ExecutedOperation : logs
VesselVisitExecution --> "1" VVEStatus : uses
Incident --> "1" IncidentStatus : uses
ComplementaryTask --> "1" TaskImpact : uses

' OEM Cross-Aggregate References
OperationPlanItem --> "1" VesselVisitNotification : references (by ID)
VesselVisitExecution --> "1" VesselVisitNotification : executes (by ID)
Incident --> "0..*" VesselVisitExecution : affects
Incident --> "1" IncidentType : classified by
ComplementaryTask --> "1" ComplementaryTaskCategory : classified by
ComplementaryTask --> "1" VesselVisitExecution : performed during

' === APPLICATION LAYER ===
package "Application Layer" {
  ' [Existing Service Interfaces Hidden for Brevity - Keeping them implies they are there]
  ' ... (Existing Services) ...

  package "OEM Services" {
    interface IStaffService {
        +CreateStaff(...)
        +UpdateStaff(...)
    }
    interface IQualificationsService {
        +CreateQualification(...)
        +UpdateQualification(...)
    }
    interface IResourcesService {
        +CreateResource(...)
        +UpdateResource(...)
    }
    interface IStorageAreasService {
        +CreateStorageArea(...)
        +UpdateStorageArea(...)
    }
    interface IDocksService {
        +CreateDock(...)
        +UpdateDock(...)
    }
    interface IVesselsService {
        +CreateVessel(...)
        +UpdateVessel(...)
    }
    interface IVesselTypesService {
        +CreateVesselType(...)
        +UpdateVesselType(...)
    }
    interface IVesselVisitNotificationsService {
        +CreateVesselVisitNotification(...)
        +UpdateVesselVisitNotification(...)
    }
    interface IRepresentativesService {
        +CreateRepresentative(...)
        +UpdateRepresentative(...)
    }
    interface IUsersService {
        +CreateUser(...)
        +UpdateUser(...)
    }
    class OperationPlanService {
        +GeneratePlan(...)
        +GetPlan(...)
    }
    class VesselVisitExecutionService {
        +CreateExecution(...)
        +CompleteExecution(...)
    }
    class IncidentService {
        +CreateIncident(...)
        +ResolveIncident(...)
    }
    class ComplementaryTaskService {
        +CreateTask(...)
    }
  }
}

' === INFRASTRUCTURE LAYER ===
package "Infrastructure Layer" {
  ' [Existing Repo Interfaces Hidden for Brevity]
  ' ... (Existing Repos) ...

  package "OEM Repositories" {
    interface IStaffRepository
    interface IQualificationsRepository
    interface IResourcesRepository
    interface IStorageAreasRepository
    interface IDocksRepository
    interface IVesselsRepository
    interface IVesselTypesRepository
    interface IVesselVisitNotificationsRepository
    interface IRepresentativesRepository
    interface IUsersRepository
    class OperationPlanRepository
    class VesselVisitExecutionRepository
    class IncidentRepository
    class ComplementaryTaskRepository
  }
}

' === API LAYER ===
package "API Layer" {
  ' [Existing Controllers Hidden for Brevity]
  ' ... (Existing Controllers) ...

  package "OEM Controllers" {
    class StaffController
    class QualificationsController
    class ResourcesController
    class StorageAreasController
    class DocksController
    class VesselsController
    class VesselTypesController
    class VesselVisitNotificationsController
    class RepresentativesController
    class UsersController
    class OperationPlansController
    class VesselVisitExecutionsController
    class IncidentsController
    class ComplementaryTasksController
  }
}

