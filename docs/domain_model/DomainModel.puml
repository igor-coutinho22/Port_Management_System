@startuml
title Shipping Port Management - Complete Domain Model (Corrected UML + DDD Layers)

' === DOMAIN LAYER ===
package "Domain Layer" {

  ' ---- STAFF AGGREGATE ----
  package "Staff Aggregate" {
    class Staff {
      +Id : Guid
      +MecanographicNumber : string
      +ShortName : string
      +Email : string
      +Phone : string
      +OperationalWindow : Schedule
      +Status : StaffStatus
      +Qualifications : List<QualificationLink>
    }

    class StaffStatus
    class Schedule
    class QualificationLink {
      +StaffId : Guid
      +QualificationId : Guid
    }
  }

  ' ---- QUALIFICATION AGGREGATE ----
  package "Qualification Aggregate" {
    class Qualification {
      +Id : Guid
      +Code : string
      +Name : string
    }
  }

  ' ---- RESOURCE AGGREGATE ----
  package "Resource Aggregate" {
    class Resource {
      +Id : Guid
      +Name : string
      +TypeId : Guid
      +AssignedStaffId : Guid
      +AvailabilityStatus : string
    }

    class ResourceType {
      +Id : Guid
      +Name : string
      +Description : string
    }
  }

  ' ---- STORAGE AREA AGGREGATE ----
  package "StorageArea Aggregate" {
    class StorageArea {
      +Id : Guid
      +Name : string
      +Capacity : int
      +TypeId : Guid
    }
    class StorageAreaType {
      +Id : Guid
      +Name : string
    }
  }

  ' ---- VESSEL AGGREGATE ----
  package "Vessel Aggregate" {
    class Vessel {
      +Id : Guid
      +Name : string
      +IMO : string
      +VesselTypeId : Guid
    }
    class VesselType {
      +Id : Guid
      +Code : string
      +Description : string
    }
  }

  ' ---- VESSEL VISIT NOTIFICATION AGGREGATE ----
  package "Vessel Visit Notification Aggregate" {
    class VesselVisitNotification {
      +Id : Guid
      +VisitDate : DateTime
      +VesselId : Guid
      +DockId : Guid
      +Status : string
      +LoadingManifestId : Guid
      +UnloadingManifestId : Guid
    }

    class Dock {
      +Id : Guid
      +Name : string
      +Capacity : int
    }

    class CargoManifest {
      +Id : Guid
      +ManifestTypeId : Guid
      +VesselVisitNotificationId : Guid
    }

    class CargoManifestType {
      +Id : Guid
      +Description : string
    }

    class ShippingAgent {
      +Id : Guid
      +Name : string
      +Address : string
    }

    class ShippingAgentRepresentative {
      +Id : Guid
      +Name : string
      +Email : string
      +ShippingAgentId : Guid
    }
  }
}

' === AGGREGATE RELATIONSHIPS ===
Staff "0..*" --> "0..*" Qualification : possesses >
Resource "0..*" --> "1" Staff : operated by >
Vessel "1" --> "1" VesselType : is of >
StorageArea "1" --> "1" StorageAreaType : is of >
VesselVisitNotification "1" --> "1" Vessel : specifies >
VesselVisitNotification "1" --> "1" Dock : assigned to >
VesselVisitNotification "0..2" --> "1" CargoManifest : includes >
CargoManifest "1" --> "1" CargoManifestType : is of >
VesselVisitNotification "1" --> "1" ShippingAgentRepresentative : submitted by >
ShippingAgentRepresentative "1" --> "1" ShippingAgent : belongs to >

' === APPLICATION LAYER ===
package "Application Layer" {
  class StaffService
  class QualificationService
  class ResourceService
  class StorageAreaService
  class VesselService
  class VesselVisitNotificationService
}

StaffService --> IStaffRepository
QualificationService --> IQualificationRepository
ResourceService --> IResourceRepository
StorageAreaService --> IStorageAreaRepository
VesselService --> IVesselRepository
VesselVisitNotificationService --> IVesselVisitNotificationRepository

' === INFRASTRUCTURE LAYER ===
package "Infrastructure Layer" {
  interface IStaffRepository
  class StaffRepository
  interface IQualificationRepository
  class QualificationRepository
  interface IResourceRepository
  class ResourceRepository
  interface IStorageAreaRepository
  class StorageAreaRepository
  interface IVesselRepository
  class VesselRepository
  interface IVesselVisitNotificationRepository
  class VesselVisitNotificationRepository
}

StaffRepository -up-|> IStaffRepository
QualificationRepository -up-|> IQualificationRepository
ResourceRepository -up-|> IResourceRepository
StorageAreaRepository -up-|> IStorageAreaRepository
VesselRepository -up-|> IVesselRepository
VesselVisitNotificationRepository -up-|> IVesselVisitNotificationRepository

' === API LAYER ===
package "API Layer" {
  class StaffController
  class QualificationController
  class ResourceController
  class StorageAreaController
  class VesselController
  class VesselVisitNotificationController
}

StaffController --> StaffService
QualificationController --> QualificationService
ResourceController --> ResourceService
StorageAreaController --> StorageAreaService
VesselController --> VesselService
VesselVisitNotificationController --> VesselVisitNotificationService

@enduml
