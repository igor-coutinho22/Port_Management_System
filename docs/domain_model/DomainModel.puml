@startuml DomainModel
title Shipping Port Management System - Complete Domain Model

' === DOMAIN LAYER ===
package "Domain Layer" {

  ' ---- STAFF AGGREGATE ----
  package "Staff Aggregate" <<Aggregate>> {
    class Staff <<AggregateRoot>> {
      +MecanographicNumber : string <<PK>>
      +ShortName : string
      +Email : string
      +Phone : string
      +Status : StaffStatus
      +OperationalWindow : string
      +QualificationLinks : ICollection<QualificationLink>
      --
      +Activate() : void
      +Deactivate() : void
    }

    enum StaffStatus {
      Available
      Unavailable
    }

    class QualificationLink <<Entity>> {
      +StaffMecanographicNumber : string <<FK>>
      +QualificationCode : string <<FK>>
    }
  }

  ' ---- QUALIFICATION AGGREGATE ----
  package "Qualification Aggregate" <<Aggregate>> {
    class Qualification <<AggregateRoot>> {
      +Code : string <<PK>>
      +Name : string
      +QualificationLinks : ICollection<QualificationLink>
    }
  }

  ' ---- RESOURCE AGGREGATE ----
  package "Resource Aggregate" <<Aggregate>> {
    class Resource <<AggregateRoot>> {
      +Id : string <<PK>>
      +Description : string
      +ResourceType : ResourceType
      +OperationalCapacity : int
      +Status : ResourceAvailabilityStatus
      +SetupTime : int
      +QualificationCodes : List<string> <<FK to Qualification>>
    }

    enum ResourceType {
      STSCrane
      YardCrane
      Truck
      Tractor
    }

    enum ResourceAvailabilityStatus {
      Active
      Maintenance
      Inactive
    }
  }

  ' ---- STORAGE AREA AGGREGATE ----
  package "StorageArea Aggregate" <<Aggregate>> {
    abstract class StorageArea <<AggregateRoot>> {
      +Id : int <<PK>>
      +Name : string
      +Type : StorageAreaType
      +MaxCapacityTeu : int
      +CurrentOccupancyTeu : int
      +DockConnections : ICollection<DockStorageAreaInfo>
      --
      +CanAddTeus(teusToAdd: int) : bool
      +ChangeMaxCapacity(newMaxCapacityTeu: int) : void
      +UpdateCurrentOccupancy(newOccupancyTeu: int) : void
      +GetInfoForDock(dockId: Guid) : DockStorageAreaInfo
      +SetInfoForDock(dockId: Guid, info: DockStorageAreaInfo) : void
      +RemoveInfoForDock(dockId: Guid) : bool
      {abstract} +GetUsageDescription() : string
    }

    class ContainerYard {
      +DockIds : List<Guid> <<FK to Dock>>
      --
      +GetUsageDescription() : string
    }

    class Warehouse {
      +SpecializedCargoType : string
      --
      +UpdateCargoType(newType: string) : void
      +GetUsageDescription() : string
    }

    enum StorageAreaType {
      ContainerYard
      Warehouse
    }

    class DockStorageAreaInfo <<Entity>> {
      +Id : int <<PK>>
      +DockId : Guid <<FK>>
      +StorageAreaId : int <<FK>>
      +DistanceMeters : double
      +TravelSeconds : int
    }
  }

  ' ---- DOCK AGGREGATE ----
  package "Dock Aggregate" <<Aggregate>> {
    class Dock <<AggregateRoot>> {
      +Id : Guid <<PK>>
      +Name : string
      +Location : string
      +LengthMeters : double
      +DepthMeters : double
      +MaxDraftMeters : double
      +AllowedVesselTypeNames : List<string> <<FK to VesselType>>
      --
      +Update(name: string, location: string, length: double, depth: double, maxDraft: double, allowedVesselTypes: List<VesselType>) : void
      +AllowVesselType(vesselType: VesselType) : void
      +DisallowVesselType(vesselType: VesselType) : void
    }
  }

  ' ---- VESSEL AGGREGATE ----
  package "Vessel Aggregate" <<Aggregate>> {
    class Vessel <<AggregateRoot>> {
      +IMO : string <<PK>>
      +VesselName : string
      +OperatorName : string
      +VesselTypeName : string <<FK>>
      +RequiredCraneCount : int
      +RequiredDockLength : double
      +Bays : int
      +Rows : int
      +Tiers : int
      +CargoGrid : VesselGrid <<NotMapped>>
      --
      +IsValidIMO(imo: string) : bool <<static>>
    }

    class VesselGrid <<ValueObject>> {
      +Containers : Container[,,]
      +Bays : int
      +Rows : int
      +Tiers : int
      --
      +CanPlaceContainer(bay: int, row: int, tier: int) : bool
      +PlaceContainer(container: Container, bay: int, row: int, tier: int) : void
      +RemoveContainer(bay: int, row: int, tier: int) : Container
    }

    class Container <<ValueObject>> {
      +Id : Guid
      +Type : string
      +Weight : double
    }
  }

  ' ---- VESSEL TYPE AGGREGATE ----
  package "Vessel Type Aggregate" <<Aggregate>> {
    class VesselType <<AggregateRoot>> {
      +Name : string <<PK>>
      +Description : string
      +MaxBays : int
      +MaxRows : int
      +MaxTiers : int
      +MaxTEUCapacity : int <<computed>>
      --
      +CreateForUpdate(name: string, description: string, maxBays: int, maxRows: int, maxTiers: int) : VesselType <<static>>
    }
   }

  ' ---- VESSEL VISIT NOTIFICATION AGGREGATE ----
  package "Vessel Visit Notification Aggregate" <<Aggregate>> {
    class VesselVisitNotification <<AggregateRoot>> {
      +Id : Guid <<PK>>
      +VesselIMO : string <<FK>>
      +VisitDate : DateTime
      +DockId : Guid <<FK>>
      +Status : VesselVisitStatus
      +Purpose : VisitPurpose
      +LoadingManifest : CargoManifest
      +UnloadingManifest : CargoManifest
      +Crew : List<CrewMember>
      +DecisionLogs : List<DecisionLog>
      --
      +AddLoadingManifest(manifest: CargoManifest) : void
      +AddUnloadingManifest(manifest: CargoManifest) : void
      +AddCrewMember(name: string, citizenId: string, nationality: string) : void
      +MarkAsSubmitted() : void
      +Approve(officerId: Guid, dockId: Guid) : void
      +Reject(officerId: Guid, reason: string) : void
      +UpdateVesselIMO(newIMO: string) : void
      +UpdatePurpose(newPurpose: VisitPurpose) : void
      +UpdateDockId(newDockId: Guid) : void
      +UpdateVisitDate(newDate: DateTime) : void
      +UpdateLoadingManifest(manifest: CargoManifest) : void
      +UpdateUnloadingManifest(manifest: CargoManifest) : void
      +UpdateCrew(crew: IEnumerable<CrewMember>) : void
    }

    enum VesselVisitStatus {
      InProgress
      Submitted
      Approved
      Rejected
    }

    enum VisitPurpose {
      Commercial
      Maintenance
    }

    class CargoManifest <<Entity>> {
      +Id : Guid <<PK>>
      +Type : CargoManifestType
      +LoadingManifestForId : Guid <<FK>>
      +UnloadingManifestForId : Guid <<FK>>
    }

    enum CargoManifestType {
      Loading
      Unloading
    }

    class DecisionLog <<Entity>> {
      +Id : Guid <<PK>>
      +OfficerId : Guid
      +Outcome : DecisionOutcome
      +Details : string
      +Timestamp : DateTime
    }

    enum DecisionOutcome {
      Approved
      Rejected
    }
  }

  ' ---- REPRESENTATIVE AGGREGATE ----
  package "Representative Aggregate" <<Aggregate>> {
    class Representative <<AggregateRoot>> {
      +Id : Guid <<PK>>
      +OrganizationId : Guid <<FK>>
      +Name : string
      +CitizenId : string
      +Nationality : string
      +Email : string
      +Phone : string
      +IsActive : bool
      --
      +Update(name: string, citizenId: string, nationality: string, email: string, phone: string) : void
      +UpdateProfile(name: string, citizenId: string, nationality: string, email: string, phone: string) : void
      +SetActive(isActive: bool) : void
    }

    class ShippingAgentOrganization <<Entity>> {
          +Id : Guid <<PK>>
          +LegalName : string
          +AlternativeNames : string
          +Address : string
          +TaxNumber : string
          --
          +Update(legalName: string, alternativeNames: string, address: string, taxNumber: string) : void
          +UpdateProfile(legalName: string, alternativeNames: string, address: string, taxNumber: string) : void
        }
  }

  ' ---- USERS AGGREGATE ----
  package "Users Aggregate" <<Aggregate>> {
    class ApplicationUser <<AggregateRoot>> {
      +Id : string <<PK>>
      +UserName : string
      +Email : string
      +EmailConfirmed : bool
      +FullName : string
    }
  }

  ' ---- CREW AGGREGATE ----
  package "Crew Aggregate" <<Aggregate>> {
    class CrewMember <<Entity>> {
      +Id : Guid <<PK>>
      +Name : string
      +CitizenId : string
      +Nationality : string
      +VesselVisitNotificationId : Guid <<FK>>
    }
  }
}

' === DOMAIN RELATIONSHIPS ===
' Inheritance within aggregates
ContainerYard --> StorageArea : is a
Warehouse --> StorageArea : is a

' Composition within aggregates (entities belong to aggregate root)
StorageArea --> "1..*" DockStorageAreaInfo : contains
Staff --> "0..*" QualificationLink : has
Qualification --> "0..*" QualificationLink : linked to
Vessel --> "1" VesselGrid : has
VesselGrid --> "0..*" Container : contains
VesselVisitNotification --> "0..2" CargoManifest : manifest
VesselVisitNotification --> "1..*" CrewMember : has crew
VesselVisitNotification --> "1..*" DecisionLog : has decisions

' Enum connections to their classes
Staff --> "1" StaffStatus : uses
Resource --> "1" ResourceType : uses
Resource --> "1" ResourceAvailabilityStatus : uses
StorageArea --> "1" StorageAreaType : uses
VesselVisitNotification --> "1" VesselVisitStatus : uses
VesselVisitNotification --> "1" VisitPurpose : uses
CargoManifest --> "1" CargoManifestType : uses
DecisionLog --> "1" DecisionOutcome : uses

' UNIDIRECTIONAL Cross-Aggregate References (Aggregate Root to Aggregate Root only)
' Note: These are implemented as ID references, not object references
Representative "1..*" --> "1" ShippingAgentOrganization : is part of
Representative "1" --> "0..*" VesselVisitNotification : requests
CrewMember "1" --> "1" ApplicationUser : is
Vessel "0..*" --> "1" VesselType : VesselTypeName
VesselVisitNotification "0..*" --> "1" Vessel : vesselIMO
VesselVisitNotification "0..*" --> "1" Dock : dockId
StorageArea "0..*" --> "0..*" Dock : dockIds (ContainerYard)
Resource "0..*" --> "1..*" Qualification : qualificationCodes

