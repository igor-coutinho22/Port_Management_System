@startuml
title Shipping Port Management - Domain Model (C4/DDD Style)

' === SYSTEM CONTEXT ===
System_Boundary(system, "Port Management System") {

  ' === Aggregates as Bounded Contexts ===
  Container_Boundary(staffBC, "Staff Aggregate") {
    Entity(staffRoot, "Staff (Aggregate Root)", "Represents operational staff members.")
    Entity(staffStatus, "StaffStatus", "Value Object")
    Entity(schedule, "Schedule", "Value Object")
  }

  Container_Boundary(qualificationBC, "Qualification Aggregate") {
    Entity(qualificationRoot, "Qualification (Aggregate Root)", "Skill or certification definition.")
  }

  Container_Boundary(resourceBC, "Resource Aggregate") {
    Entity(resourceRoot, "Resource (Aggregate Root)", "Represents a port resource (crane, truck).")
  }

  Container_Boundary(storageBC, "StorageArea Aggregate") {
    Entity(storageRoot, "StorageArea (Aggregate Root)")
    Entity(storageType, "StorageAreaType", "Value Object / Type Entity")
  }

  Container_Boundary(vesselBC, "Vessel Aggregate") {
    Entity(vesselRoot, "Vessel (Aggregate Root)")
    Entity(vesselType, "VesselType", "Type Entity")
  }

  ' === Application Services and APIs ===
  Component(staffService, "StaffService", "Application Service")
  Component(qualificationService, "QualificationService", "Application Service")
  Component(resourceService, "ResourceService", "Application Service")
  Component(vesselService, "VesselService", "Application Service")
  Component(storageService, "StorageAreaService", "Application Service")

  Component(staffApi, "StaffController", "API Endpoint")
  Component(qualificationApi, "QualificationController", "API Endpoint")
  Component(resourceApi, "ResourceController", "API Endpoint")
  Component(vesselApi, "VesselController", "API Endpoint")
  Component(storageApi, "StorageAreaController", "API Endpoint")
}

' === Relationships between Aggregates ===
Rel(staffRoot, qualificationRoot, "Uses qualifications")
Rel(resourceRoot, staffRoot, "Operated by staff")
Rel(vesselRoot, vesselType, "Classified by")
Rel(storageRoot, storageType, "Defined by type")

' === API ↔ Application Layer Relationships ===
Rel(staffApi, staffService, "Invokes")
Rel(qualificationApi, qualificationService, "Invokes")
Rel(resourceApi, resourceService, "Invokes")
Rel(vesselApi, vesselService, "Invokes")
Rel(storageApi, storageService, "Invokes")

' === Application ↔ Domain Relationships ===
Rel(staffService, staffRoot, "Manages Staff Aggregate")
Rel(qualificationService, qualificationRoot, "Manages Qualification Aggregate")
Rel(resourceService, resourceRoot, "Manages Resource Aggregate")
Rel(vesselService, vesselRoot, "Manages Vessel Aggregate")
Rel(storageService, storageRoot, "Manages Storage Aggregate")

@enduml
