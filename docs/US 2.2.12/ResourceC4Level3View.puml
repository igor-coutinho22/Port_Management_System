@startuml ResourceC4Views_Component
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
title C4 Level 3 - Component Diagram (Resource Module)

Container_Boundary(appService, "Application Layer") {
    Component(resourceController, "ResourcesController", "API Controller", "Handles REST endpoints for Resources")
    Component(resourceService, "ResourceService", "Application Service", "Implements business logic")
    Component(resourceMapper, "ResourceMapper", "Mapper", "Maps between DTO and domain")
}

Container_Boundary(domain, "Domain Layer") {
    Component(resourceEntity, "Resource", "Entity", "Represents physical resource")
    Component(resourceType, "ResourceType", "Enum", "Defines type (STS Crane, Truck, etc.)")
    Component(resourceStatus, "ResourceAvailabilityStatus", "Enum", "Defines availability (Active, Inactive, Maintenance)")
    Component(resourceRepoInt, "IResourceRepository", "Interface", "Abstraction for data access")
}

Container_Boundary(infra, "Infrastructure Layer") {
    Component(resourceRepo, "ResourceRepository", "Repository", "Implements data access with EF Core")
    Component(dbCtx, "PortManagementContext", "DbContext", "Manages EF Core operations")
}

Rel(resourceController, resourceService, "Calls")
Rel(resourceService, resourceMapper, "Maps objects")
Rel(resourceService, resourceRepoInt, "Uses")
Rel(resourceRepoInt, resourceRepo, "Implemented by")
Rel(resourceRepo, dbCtx, "Reads/Writes Resources")

SHOW_LEGEND()
@enduml
