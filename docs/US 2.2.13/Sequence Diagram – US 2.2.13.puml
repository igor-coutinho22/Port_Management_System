@startuml
title SSD - US 2.2.13: Register and Manage Qualifications

actor "Logistics Operator" as Operator
boundary "API Layer\nQualificationsController" as API
control "Application Layer\nQualificationService" as Service
entity "Infrastructure Layer\nQualificationRepository" as Repo
database "Database\nPortManagementContext" as DB

== Register Qualification ==
Operator -> API : POST /api/qualifications\n(QualificationDTO { Code, Name })
API -> Service : RegisterQualificationAsync(code, name)
Service -> Repo : GetByCodeAsync(code)
Repo -> DB : SELECT * FROM Qualifications WHERE Code = code
DB --> Repo : Qualification not found
Service -> Repo : AddAsync(new Qualification(code, name))
Repo -> DB : INSERT INTO Qualifications (Code, Name)
DB --> Repo : Success
Repo --> Service : Qualification added
Service --> API : Success (QualificationDTO)
API --> Operator : 201 Created + QualificationDTO

== Retrieve Qualification ==
Operator -> API : GET /api/qualifications/{code}
API -> Service : GetByCodeAsync(code)
Service -> Repo : GetByCodeAsync(code)
Repo -> DB : SELECT * FROM Qualifications WHERE Code = code
DB --> Repo : Qualification found
Repo --> Service : Qualification
Service --> API : QualificationDTO
API --> Operator : 200 OK + QualificationDTO

== Update Qualification ==
Operator -> API : PUT /api/qualifications/{code}\n(QualificationDTO)
API -> Service : UpdateQualificationAsync(Qualification)
Service -> Repo : UpdateAsync(Qualification)
Repo -> DB : UPDATE Qualifications SET Name = ... WHERE Code = ...
DB --> Repo : Success
Repo --> Service : OK
Service --> API : NoContent()
API --> Operator : 204 No Content

== Delete Qualification ==
Operator -> API : DELETE /api/qualifications/{code}
API -> Service : DeleteAsync(code)
Service -> Repo : DeleteAsync(code)
Repo -> DB : DELETE FROM Qualifications WHERE Code = code
DB --> Repo : Success
Repo --> Service : OK
Service --> API : NoContent()
API --> Operator : 204 No Content
@enduml
