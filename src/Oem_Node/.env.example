# Copy this file to .env and fill in the values

# HTTP port of the OEM service
PORT=6001

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/oem-db

# Base URL of the WebApp (master data) API
WEBAPP_API_URL=https://localhost:5001

# Microsoft Entra External ID (CIAM) configuration
AZURE_AUTHORITY_HOST=https://sinesport.ciamlogin.com
AZURE_TENANT_ID=a8192c11-2c11-4411-a807-8b0659f4c9a9
AZURE_CLIENT_ID=6bff1175-b880-4a1d-b320-ff8fcbbd1b99
AZURE_CLIENT_SECRET=
# Accepted token audiences (comma separated). Defaults to api://port-management and AZURE_CLIENT_ID
# AZURE_API_AUDIENCES=api://port-management

# App id (without dashes) of the app that owns the custom 'Role' user attribute
AZURE_EXTENSIONS_APP_ID=af873478749f4ad684965e10cdd75e5f
